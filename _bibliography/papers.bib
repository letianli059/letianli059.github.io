@article{li2026srof,
  abbr            = {STAT},
  preview         = {srof.png},
  title           = {{Row-Wise Fusion Regularization: An Interpretable Personalized Federated Learning Framework in Large-Scale Scenarios}},
  author          = {Zhou, Runlin and Li*, Letian and Zheng, Zemin},
  journal         = {Stat},
  volume          = {15},
  number          = {1},
  pages           = {e70147},
  year            = {2026},
  month           = {Mar},
  status          = {published},
  abstract        = {We study personalized federated learning for multivariate responses where client models are heterogeneous yet share variable-level structure. Existing entry-wise penalties ignore cross-response dependence, while matrix-wise fusion over-couples clients. We propose a Sparse Row-wise Fusion (SROF) regularizer that clusters row vectors across clients and induces within-row sparsity, and we develop RowFed, a communication-efficient federated algorithm that embeds SROF into a linearized ADMM framework with privacy-preserving partial participation. Theoretically, we establish an oracle property for SROF---achieving correct variable-level group recovery with asymptotic normality---and prove convergence of RowFed to a stationary solution. Under random client participation, the iterate gap contracts at a rate that improves with participation probability. Empirically, simulations in heterogeneous regimes show that RowFed consistently lowers estimation and prediction error and strengthens variable-level cluster recovery over NonFed, FedAvg and a personalized matrix-fusion baseline. A real-data study further corroborates these gains while preserving interpretability. Together, our results position row-wise fusion as an effective and transparent paradigm for large-scale personalized federated multivariate learning, bridging the gap between entry-wise and matrix-wise formulations.},
  doi             = {10.1002/sta4.70147},
  html            = {https://onlinelibrary.wiley.com/doi/10.1002/sta4.70147},
  pdf             = {https://arxiv.org/pdf/2510.14413},
  annotation      = {* Corresponding author}
}

@article{li2025true,
  abbr            = {IJOC},
  preview         = {true.png},
  title           = {{Truncated Fusion Learning on Supervised Clustering and Its Fast Stagewise Algorithm}},
  author          = {Li, Letian and Li, Yang and Zhang, Jie and Zheng, Zemin},
  journal         = {INFORMS Journal on Computing},
  year            = {2025},
  month           = {Dec},
  status          = {published},
  abstract        = {Supervised clustering has emerged to be a popular topic for studying heterogeneous effects in diverse areas such as risk management and medical science. In this paper, we introduce a general heterogeneity tracking model that accommodates various common paradigms for supervised clustering. Building on this new model, we propose a novel method called truncated fusion learning (TRUE) for conducting clustering, which involves a nonconvex fusion penalized optimization. For implementation, we innovate a thresholded fusion stagewise algorithm that allows for quickly tracing out the entire solution paths of TRUE. Under mild regularity conditions, we provide comprehensive theoretical guarantees including the convergence of the proposed algorithm, as well as consistency in parameter estimation, cluster recovery, and model selection. The superior performance of our method is demonstrated by several simulation examples and applications to two real data sets.},
  doi             = {10.1287/ijoc.2024.0840},
  html            = {https://pubsonline.informs.org/doi/abs/10.1287/ijoc.2024.0840},
  pdf             = {https://pubsonline.informs.org/doi/pdf/10.1287/ijoc.2024.0840}
}

@article{li2025scale,
  abbr     = {S&C},
  preview  = {scale.png},
  title    = {{Personalized Federated Learning on Large-Scale Association Networks}},
  author   = {Li, Letian and Zhou, Runlin and Zheng, Zemin},
  journal  = {Statistics and Computing},
  volume   = {35},
  number   = {5},
  pages    = {149},
  year     = {2025},
  month    = {Jul},
  status   = {published},
  abstract = {Federated learning (FL) has rapidly gained traction for its capacity to facilitate collaborative model training across decentralized data sources while maintaining data privacy. Addressing the challenges stemming from intrinsic heterogeneity in local data distributions, personalization has become an essential aspect in advancing FL techniques. In this study, we introduce a new personalized federated learning (PFL) framework for recovering large-scale response-predictor association networks, named sparse clustered association learning (SCALE). This approach subtly incorporates sparse orthogonal factor learning and fusion penalization, enabling the joint exploration of latent relationships and structured clustering. To operationalize SCALE, we develop the PerFL-LSAN algorithm, tailored specifically for large-scale association networks recovery within federated settings. Theoretical analyses confirm the convergence guarantee of the PerFL-LSAN algorithm and the statistical consistency of the proposed estimator. We further validate the practical effectiveness of the new method through multiple simulation experiments and a real-world application on the Communities and Crime dataset.},
  doi      = {10.1007/s11222-025-10684-w},
  html     = {https://link.springer.com/article/10.1007/s11222-025-10684-w},
  pdf      = {https://link.springer.com/content/pdf/10.1007/s11222-025-10684-w.pdf}
}

@article{li2020stockbond,
  abbr     = {FDR},
  preview  = {stock-bond.png},
  title    = {{Research on the Influencing Factors of Long-term Dynamic Correlation of Chinese Stock and Bond Market---Based on the Perspective of Macroeconomic Uncertainty and Synchronization}},
  author   = {Li, Letian and Li, Xuan and Hu, Ruilin and Li, Bin},
  journal  = {Financial Development Research},
  number   = {4},
  pages    = {8--16},
  year     = {2020},
  month    = {Apr},
  status   = {published},
  abstract = {Based on non-arbitrage affine model of modern macro-economics and pricing method of “pricing kernel”, this paper splits the correlation coefficient between stock market and bond market yield into its main driving factors---the uncertainty of inflation and real interest rate, as well as the covariance among inflation, real interest rate and dividend yield. In the empirical part, DCC-MGARCH model is first used to calculate the dynamic correlation coefficient of stock market and bond market yields, verifying the time-varying rule of correlation between Chinese stocks and bonds. Then, the paper explores the contribution of the selected explanatory variables to the correlation between Chinese stocks and bonds through regression analysis. The results show that the uncertainty of inflation, real interest rate and dividend yield, and the covariance among the three are the main factors affecting the correlation. Inflation shocks, real interest rates and dividend yields explain the temporary divergence from long-term dynamics. Among them, the impact of the uncertainty of inflation and dividend yield on the correlation between stocks and bonds is different from that of other major European and American countries, which reflects the particularity of the Chinese economic market. In addition, compared with the stable period of China's economic market, the influence of these economic factors will change during the period of stock market turbulence, and the explanatory power of the model will be reduced.},
  note     = {<strong>Annual Best Paper Award</strong>}
}

@article{li_reach,
  abbr            = {JBES},
  preview         = {reach.png},
  title           = {{Heterogeneity Pursuit in Large-Scale Association Networks via REACH}},
  author          = {Li, Letian and Zheng, Zemin and Zhang, Bo and Zhang, Jie},
  journal         = {Journal of Business \& Economic Statistics},
  year            = {2026+},
  status          = {accepted},
  abstract        = {Recovering the large-scale response-predictor association network is of great practical importance, which can be regarded as a special type of multi-task supervised learning widely applied in various modern scientific areas such as social media marketing and medical science. In big data applications, the complex dependence structures between responses and predictors frequently exhibit heterogeneity since samples are often collected from multi-mode populations, yet identifying the heterogeneity in the association networks has not been comprehensively studied. To fill this gap, we propose a new approach for heterogeneity identification in the large-scale association networks called regularized rank-constrained heterogeneity pursuit (REACH). It combines the techniques of rank-constrained group regularization and pairwise fusion penalization to achieve simultaneous dimension reduction and heterogeneity identification. To implement the proposed method, we develop a new algorithm based on the augmented Lagrangian method coupled with block coordinate descent (ALM-BCD) and derive its convergence guarantees. Under mild regularity conditions, we show that REACH enjoys nice sampling properties including consistency in estimation, prediction, heterogeneity recovery, and rank selection. Moreover, we also demonstrate that the proposed estimator attains the minimax optimal rate. The practical utility of our suggested method is illustrated through simulation examples and an application to the Communities and Crime Dataset.},
  note            = {<strong>Accepted; online publication pending.</strong>}
}

@unpublished{wang_menu,
  abbr    = {PREPRINT},
  preview = {menu.png},
  title   = {{Accuracy-Menu Screening for Data Services under Network-Compressed Operating Value}},
  author  = {Wang, Xianjia and Liu, Jie and Li, Letian},
  status  = {manuscript},
  submission_stage = {submission},
  author_position = {3},
  preprint_order = {7},
  abstract = {Data-service providers increasingly sell information products whose value depends on how buyers translate information into downstream operating decisions. We study how a monopolist data seller should price the accuracy of a signal when buyers are privately informed and downstream consumers interact through negative network externalities. We develop a sequential screening model in which the seller offers accuracy–fee menus, the buyer uses the acquired signal to make entry and pricing decisions, and consumers choose quantities in a networked market. The model contrasts marketing-list services, which create market access, with data-append services, which improve an existing customer file. Under weak externalities and an interior consumption equilibrium, we characterize how willingness to pay for accuracy is shaped by downstream entry, pricing, and networked consumption. Negative network externalities compress the operating value of more accurate information through an aggregate multiplier; because the cost of producing accuracy is not compressed, fine differentiation becomes less profitable. The results identify when premium accuracy, screening separation, pooling, and append-upgrade incentives emerge, and show how baseline information can cause a high-cost buyer to value externally appended accuracy more than a low-cost buyer does.},
  note    = {In submission.}
}

@unpublished{li_mtdp,
  abbr    = {PREPRINT},
  preview = {mtdp.png},
  title   = {{Multi-task Dynamic Pricing under Sparse Heterogeneity with High-Dimensional Data}},
  author  = {Li, Letian and Zhang, Jie and Li, Yang},
  status  = {manuscript},
  submission_stage = {submission},
  author_position = {1},
  preprint_order = {2},
  abstract = {With rapid technological advancements and the widespread presence of online marketplaces, many firms can implement a personalized pricing policy using contextual information of customers from several, possibly heterogeneous sources. For instance, a firm may aim to learn the demand model of a product at different retail stores to optimize pricing or inventory decisions, facilitating joint learning and knowledge transfer among stores. In this paper, we propose a multi-task dynamic pricing framework for integrative analysis using data from multiple sources, enabling dynamic pricing based on the prevailing demand model, which is defined as the model supported by the majority of sites. The demand model is assumed to be a high-dimensional linear model under sparse heterogeneity where the source/task associated parameters are composed of a global (shared) parameter and a sparse task-specific term. We propose the multi-task dynamic pricing (MTDP) algorithm, which leverages the shared parameter across all tasks and then refines the sparse task-specific parameters for each individual task. Under mild conditions, we derive a new high probability error bound for the multi-task estimator and establish an upper bound for the regret of the MTDP algorithm. Our theoretical analysis demonstrates that the proposed MTDP policy outperforms the single-task pricing policy. Furthermore, we corroborate the efficiency of the proposed policy through extensive simulation experiments and a real data application, which illustrate practical value of incorporating multi-task learning in dynamic pricing.},
  note    = {In submission.}
}

@unpublished{li_rcolab,
  abbr    = {PREPRINT},
  preview = {r-colab.png},
  title   = {{Robust Cooperative Multi-Agent Recommendation with Mixed Sources: A Provably Efficient Bandit Approach}},
  author  = {Li, Letian and Zhao, Rui and Zheng, Zemin},
  status  = {manuscript},
  submission_stage = {submission},
  author_position = {1},
  preprint_order = {3},
  abstract = {Problem definition: Modern recommendation systems increasingly span distributed, heterogeneous sources like regional markets. While shared latent user preferences make collaborative learning attractive, real-world deployments are routinely disrupted by localized structural deviations and adversarial contamination. In this paper, we investigate how platforms can deliver personalized recommendations that exploit shared structures among informative sources while remaining robust to arbitrary potential contamination. Methodology: We formulate a multi-agent contextual bandit that bounds subspace deviations among aligned agents while accommodating an arbitrary fraction of outlier sources. We propose the Robust Collaborative Multi-Agent Bandit (R-CoLAB), a distributed online algorithm coupling projection-based robust aggregation of local estimators with a bias-corrected regularized policy that adaptively balances global consensus and local autonomy. Results: The proposed R-CoLAB attains sharp non-asymptotic estimation error bounds together with an interpretable regret upper bound that adapts seamlessly to the underlying degrees of heterogeneity and contamination. It recovers the optimal collaborative rate in benign environments and gracefully degrades to the single-agent rate under severe contamination. A matching minimax lower bound establishes the near-optimality of our algorithm. Comprehensive simulation studies and empirical evaluations on the Yelp and KuaiRand datasets demonstrate substantial performance gains over established baselines. Managerial implications: Platform operators can collaboratively leverage statistical strength across disparate markets without manually verifying source reliability. The framework autonomously safeguards against adversarial data anomalies while preserving user privacy through parameter-only server-agent communication.},
  note    = {In submission.}
}

@unpublished{li_sndp,
  abbr    = {PREPRINT},
  preview = {sndp.png},
  title   = {{Feature-Sparse Neural Demand Learning for High-Dimensional Contextual Dynamic Pricing}},
  author  = {Li, Letian and Zhang, Jie and Zheng, Zemin},
  status  = {manuscript},
  submission_stage = {submission},
  author_position = {1},
  preprint_order = {4},
  abstract = {Recent advances in data collection technologies and the widespread presence of online retailers have enabled firms to collect rich contextual information for implementing personalized pricing policies. However, the relationship between consumer demand and contextual covariates is often complex and highly nonlinear, making traditional parametric models restrictive and prone to model misspecification. In this paper, we study the contextual dynamic pricing problem under nonparametric demand models in high-dimensional settings. To flexibly estimate the unknown and complex demand function while overcoming the curse of dimensionality, we incorporate a feature-sparse deep neural network architecture into the dynamic pricing framework. We then propose the group-ℓ₀-constrained neural network learning assisted dynamic pricing (GCNN-DP) algorithm based on the exploration-exploitation mechanism. Under some mild conditions, we establish the regret upper bound for the GCNN-DP algorithm, which achieves regret of order O(T^((2β′+1)/(4β′+1)) (log T + s log(d/s))). Here, T denotes the time horizon, d is the covariates dimension, s is the sparsity level of the significant covariates and β′ ≥ 1 is the smoothness parameter. In the limiting case β′ → ∞, the upper bound reduces to O(√T), matching the optimal rate for high-dimensional linear demand models. The regret bound depends only logarithmically on the covariate dimensionality, thereby effectively alleviating the curse of dimensionality in high-dimensional nonparametric problems. Moreover, we demonstrate the effectiveness of the proposed policy through extensive simulation experiments and a real data application, highlighting the practical value of capturing complex demand-covariate relationships in dynamic pricing.},
  note    = {In submission.}
}

@unpublished{li_super,
  abbr    = {S&C},
  preview = {super.png},
  title   = {{SUPER: Computationally Efficient Scale-Adaptive Fusion Penalized Regression for Subgroup Identification}},
  author  = {Li, Letian and Wu, Jie and Li, Daoji and Zheng, Zemin},
  status  = {manuscript},
  submission_stage = {revision},
  author_position = {1},
  preprint_order = {1},
  abstract = {Subgroup identification has attracted significant attention in recent years as heterogeneity becomes increasingly prevalent in many applications. Since the number of subgroups is often unknown in practice, pairwise fusion-penalized approaches have been widely used for subgroup analysis. However, these methods usually require repeatedly solving the penalized problem over a grid of fusion-penalty parameter values and selecting the optimal value by an information criterion or cross-validation, which can dominate the computational cost. To address this challenge, we propose a computationally efficient method for subgroup identification, termed scaled fusion penalized regression (SUPER). The proposed approach estimates the noise level in fusion-penalized regression and uses it to calibrate the effective fusion penalty, thereby avoiding the outer grid search over the original fusion-penalty parameter and substantially reducing computational cost. We develop an algorithm based on the alternating direction method of multipliers (ADMM) to efficiently implement the proposed method. We further establish the consistency and asymptotic normality of the resulting estimator, providing theoretical guarantees for the procedure. Both computational and theoretical advantages of SUPER are demonstrated by simulation studies and a real data analysis.},
  note    = {Under major revision at <em>Statistics and Computing</em>.}
}

@unpublished{wu_transfer_aft,
  abbr    = {PREPRINT},
  preview = {transfer-aft.png},
  title   = {{Transfer Learning for High-dimensional Accelerated Failure Time Models}},
  author  = {Wu, Jie and Li, Daoji and Li, Letian and Zheng, Zemin},
  status  = {manuscript},
  submission_stage = {submission},
  author_position = {3},
  preprint_order = {6},
  abstract = {Transfer learning is a powerful tool to leverage information from different but related source domain to boost performance of the target task. Despite the substantial developments in various high-dimensional data analysis, survival data are insufficiently accounted by current transfer learning approaches. Random censoring mechanism, the population heterogeneity of multiple datasets and high dimensionality of predictors pose major challenges. How to properly conduct transfer learning procedure onto survival datasets to improve the statistical inference at the target and simultaneously guarantee theoretical properties remain unclear. In this paper, we propose a new transfer learning method for the high dimensional right-censored survival data under accelerated failure time (AFT) model. The proposed method applies mean imputation techniques to adjust for censoring data, thus facilitating the subsequent pooling and debiasing transfer procedures. We show that under mild conditions, the proposed method achieves lower error bounds over the existing non-transfer learning methods even there exists obstacles from censoring. We also develop an algorithm based on sample splitting to detect informative source datasets and prove that the selected informative sources is consistent with the true one. Extensive simulation results and a real data case concerning TCGA micro-array gene expression are reported to support our theoretical claims and to demonstrate the empirical usefulness of the proposed transfer learning method.},
  note    = {In submission.}
}

